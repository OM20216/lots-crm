# LOTS CRM - PRIVATE credentials template.
# Copy to C:\Users\<you>\.lots-crm\secrets.env (OUTSIDE the project folder) and fill in.
# Wrap values containing # or spaces in single quotes, e.g. MYSQL_PASSWORD='abc#123'.

# MySQL (company server)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=lots
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL=false

# SparkTG API login
SPARKTG_USERNAME=
SPARKTG_PASSWORD=
SPARKTG_SVC_ID=
SPARKTG_WEBHOOK_TOKEN=

# Microsoft 365 mailbox.
# Normally nothing is needed here: use "Sign in with Microsoft" on the Automation page.
# Optional own app registration for that sign-in (public client flows enabled):
MS_SIGNIN_CLIENT_ID=
# Alternative: IT app registration with a client secret (application permissions):
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# AI email reader (optional; Automation -> AI email reader). Without a key the keyword rules are used.
ANTHROPIC_API_KEY=

# Vtiger contacts import (Contacts -> Import -> Import from Vtiger). Access key: Vtiger -> My Preferences -> Access Key.
VTIGER_URL=
VTIGER_USERNAME=
VTIGER_ACCESS_KEY=

# Sign-in emergency switch: CRM_AUTH_OFF=1 turns "Require sign-in" off (every admin password forgotten). Leave it out normally.
# CRM_AUTH_OFF=1
