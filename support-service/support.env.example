# LOTS Support service - template. Copy to C:\Users\<you>\.lots-crm\support.env (OUTSIDE the project).
# Generate long random values for the three codes/token. Keep SUPPORT_SERVICE_TOKEN the same as
# SUPPORT_SERVICE_TOKEN in secrets.env so the CRM can call this service.
SUPPORT_PORT=4100
SUPPORT_HOST=0.0.0.0
SUPPORT_AGENT_CODE=
SUPPORT_ADMIN_CODE=
SUPPORT_SERVICE_TOKEN=
SUPPORT_DATA_DIR=C:\Users\<you>\.lots-crm\support
SUPPORT_CRM_URL=http://localhost:4000

# Optional: Teams incoming-webhook URL for new-token and agent-message alerts.
# SUPPORT_TEAMS_WEBHOOK=
