# LOTS CRM - non-secret settings. Credentials go in C:\Users\<you>\.lots-crm\secrets.env
# (see secrets.env.example), never in this file.
PORT=4000

# SparkTG (not secret: the login and service id are in the private secrets file)
SPARKTG_BASE_URL=https://telephonycloud.co.in
# Dialer widget (same as VITE_SPARKTG_WIDGET_URL in crm-vmm). Leave it out and the SparkTG dialer does not appear.
SPARKTG_WIDGET_URL=https://telephonycloud.co.in/sparktg-iframe/

# Microsoft 365 mailbox name
MAILBOX=contactus@cpwi.in

# Optional: separate data folder for a test / training copy
CRM_DATA_DIR=
